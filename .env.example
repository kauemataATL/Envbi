# Copie este arquivo para ".env" e preencha. O .env NUNCA vai para o git.

# --- n8n ---
# Qualquer texto longo e aleatório. Não troque depois de criado (criptografa as credenciais do n8n).
N8N_ENCRYPTION_KEY=troque-por-um-texto-longo-e-aleatorio
# Opcional: cole aqui a URL do túnel (ex.: https://abc-def.trycloudflare.com/) e reinicie o n8n
WEBHOOK_URL=

# --- WhatsApp Cloud API (Meta for Developers > seu app > WhatsApp > API Setup) ---
# Token de acesso (o temporário dura 24h; depois crie um token permanente de "System User")
WA_ACCESS_TOKEN=
# "Phone number ID" do número de teste (não é o número de telefone em si)
WA_PHONE_NUMBER_ID=
# Senha que VOCÊ inventa e cola também no painel da Meta ao configurar o webhook
WA_VERIFY_TOKEN=uma-senha-qualquer-que-voce-inventar
WA_GRAPH_VERSION=v23.0
# Template usado nas atualizações automáticas. "hello_world" já vem aprovado no número de teste.
# Depois que o seu template for aprovado, troque para o nome dele (ex.: atualizacao_processo)
WA_TEMPLATE_UPDATE=hello_world

# --- IA (console.anthropic.com > API Keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Regras do negócio ---
# Número da recrutadora (com 55 + DDD) para receber alertas quando o bot encaminhar
RECRUITER_PHONE=
# De quantos em quantos dias o candidato recebe atualização
UPDATE_INTERVAL_DAYS=3
